diff --git a/clang/test/CodeGen/arm-structure-size-boundary.c b/clang/test/CodeGen/arm-structure-size-boundary.c
new file mode 100644
index 000000000..15423ea50
--- /dev/null
+++ b/clang/test/CodeGen/arm-structure-size-boundary.c
@@ -0,0 +1,85 @@
+// REQUIRES: arm-registered-target
+// RUN: %clang_cc1 -triple thumbv4t-none-eabi -target-abi apcs-gnu -DAPCS -DBOUNDARY=4 -emit-llvm -o - %s | FileCheck %s --check-prefixes=COMMON,APCS
+// RUN: %clang_cc1 -triple thumbv4t-none-eabi -target-abi apcs-gnu -DAPCS -DBOUNDARY=1 -mstructure-size-boundary=8 -fsyntax-only %s
+// RUN: %clang_cc1 -triple thumbv4t-none-eabi -target-abi apcs-gnu -DAPCS -DBOUNDARY=4 -mstructure-size-boundary=64 -fsyntax-only %s
+// RUN: %clang_cc1 -triple thumbv4t-none-eabi -DBOUNDARY=1 -emit-llvm -o - %s | FileCheck %s --check-prefixes=COMMON,AAPCS
+// RUN: %clang_cc1 -triple thumbv4t-none-eabi -target-abi aapcs -DBOUNDARY=8 -mstructure-size-boundary=64 -fsyntax-only %s
+// RUN: %clang --target=thumbv4t-none-eabi -mabi=aapcs -DBOUNDARY=4 -mstructure-size-boundary=8 -mstructure-size-boundary=32 -fsyntax-only %s
+// RUN: not %clang_cc1 -triple thumbv4t-none-eabi -mstructure-size-boundary=16 -fsyntax-only %s 2>&1 | FileCheck %s --check-prefix=INVALID
+// INVALID: error: invalid value '16' in '-mstructure-size-boundary=16'
+
+#define CHECK_SIZE_ALIGN(type, size, alignment) \
+  _Static_assert(sizeof(type) == (size), #type " size"); \
+  _Static_assert(_Alignof(type) == (alignment), #type " alignment")
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#define ROUND(size, align) (((size) + (align)-1) & -(align))
+
+// APCS-DAG: %struct.Small = type { i8, [3 x i8] }
+// AAPCS-DAG: %struct.Small = type { i8 }
+// COMMON-DAG: %struct.Packed = type <{ i8, i16 }>
+// COMMON-DAG: %struct.Aligned = type { i8, [7 x i8] }
+// APCS-DAG: @smalls = {{.*}}global [2 x %struct.Small] zeroinitializer, align 4
+// AAPCS-DAG: @smalls = {{.*}}global [2 x %struct.Small] zeroinitializer, align 1
+// COMMON-DAG: @packeds = {{.*}}global [2 x %struct.Packed] zeroinitializer, align 1
+// COMMON-DAG: @aligneds = {{.*}}global [2 x %struct.Aligned] zeroinitializer, align 8
+struct Small { char c; } smalls[2];
+struct Packed { char c; short s; } __attribute__((packed)) packeds[2];
+struct Aligned { char c; } __attribute__((aligned(8))) aligneds[2];
+struct PackedAligned { char c; short s; } __attribute__((packed, aligned(2)));
+union Byte { char c; };
+struct Nested { char c; struct Small inner[2]; };
+
+CHECK_SIZE_ALIGN(struct Small, BOUNDARY, BOUNDARY);
+CHECK_SIZE_ALIGN(struct Packed, 3, 1);
+CHECK_SIZE_ALIGN(struct Aligned, 8, 8);
+CHECK_SIZE_ALIGN(struct PackedAligned, 4, 2);
+CHECK_SIZE_ALIGN(union Byte, BOUNDARY, BOUNDARY);
+CHECK_SIZE_ALIGN(struct Nested, 3 * BOUNDARY, BOUNDARY);
+_Static_assert(__builtin_offsetof(struct Nested, inner) == BOUNDARY, "nested offset");
+_Static_assert(sizeof(smalls) == 2 * BOUNDARY, "array stride");
+
+#pragma pack(push, 2)
+struct Pragma { char c; };
+#pragma pack(pop)
+#define PRAGMA_ALIGN (BOUNDARY < 2 ? BOUNDARY : 2)
+CHECK_SIZE_ALIGN(struct Pragma, PRAGMA_ALIGN, PRAGMA_ALIGN);
+
+struct Bits8 { unsigned char a : 7, b : 6; char c; };
+struct Bits16 { unsigned char a : 7; unsigned short b : 11; char c; };
+struct Bits32 { unsigned short a : 15; unsigned b : 21; char c; };
+struct Zero8 { unsigned char a : 1; unsigned char : 0; char c; };
+struct Zero16 { unsigned char a : 1; unsigned short : 0; char c; };
+struct Anon32 { unsigned : 1; char c; };
+struct PackedZero { char a; unsigned : 0; char c; } __attribute__((packed));
+
+_Static_assert(__builtin_offsetof(struct Bits8, c) == 2, "char container");
+_Static_assert(__builtin_offsetof(struct Bits16, c) == 4, "short container");
+_Static_assert(__builtin_offsetof(struct Bits32, c) == 7, "int container");
+_Static_assert(__builtin_offsetof(struct Zero8, c) == 1, "char zero-width field");
+_Static_assert(__builtin_offsetof(struct Zero16, c) == 2, "short zero-width field");
+_Static_assert(__builtin_offsetof(struct PackedZero, c) == 4, "packed zero-width field");
+CHECK_SIZE_ALIGN(struct Bits16, ROUND(5, MAX(BOUNDARY, 2)), MAX(BOUNDARY, 2));
+#ifdef APCS
+CHECK_SIZE_ALIGN(struct Zero16, ROUND(3, BOUNDARY), BOUNDARY);
+CHECK_SIZE_ALIGN(struct Anon32, ROUND(2, BOUNDARY), BOUNDARY);
+CHECK_SIZE_ALIGN(struct PackedZero, 5, 1);
+
+struct ExplicitFit {
+  unsigned char a : 7;
+  unsigned short b : 9 __attribute__((aligned(1)));
+  char c;
+};
+#pragma pack(push, 2)
+struct ExplicitPragma {
+  unsigned a : 10;
+  unsigned long long b : 22 __attribute__((aligned(8)));
+  char c;
+};
+#pragma pack(pop)
+_Static_assert(__builtin_offsetof(struct ExplicitFit, c) == 4, "explicit alignment before container fit");
+_Static_assert(__builtin_offsetof(struct ExplicitPragma, c) == 5, "pragma caps explicit alignment");
+#else
+CHECK_SIZE_ALIGN(struct Zero16, ROUND(3, MAX(BOUNDARY, 2)), MAX(BOUNDARY, 2));
+CHECK_SIZE_ALIGN(struct Anon32, MAX(BOUNDARY, 4), MAX(BOUNDARY, 4));
+CHECK_SIZE_ALIGN(struct PackedZero, 8, 4);
+#endif
