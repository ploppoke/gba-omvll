From 37a0a216311a25f7b5caffb800653a92663a778e Mon Sep 17 00:00:00 2001
From: Heni <i@pingas.org>
Date: Wed, 25 Nov 2026 23:54:00 -0600
Subject: [PATCH] Clang: match GCC bare-metal ARM APCS record layout

Apply the APCS record alignment floor before layout and use the GCC
bit-field placement rules without changing Darwin APCS or default AAPCS.
Allow explicit AArch32 ELF structure size boundaries in the driver and cc1,
and serialize the override in PCH/modules.
---
 clang/docs/ReleaseNotes.md                    |  8 ++
 clang/include/clang/Basic/TargetInfo.h        |  8 ++
 clang/include/clang/Basic/TargetOptions.h     |  3 +
 clang/include/clang/Options/Options.td        |  4 +
 clang/lib/AST/RecordLayoutBuilder.cpp         | 30 ++++++-
 clang/lib/Basic/Targets/ARM.cpp               | 35 +++++---
 clang/lib/Basic/Targets/ARM.h                 |  5 ++
 clang/lib/Driver/ToolChains/Clang.cpp         |  2 +
 clang/lib/Frontend/CompilerInvocation.cpp     | 17 +++-
 clang/lib/Serialization/ASTReader.cpp         |  2 +
 clang/lib/Serialization/ASTWriter.cpp         |  1 +
 .../CodeGen/arm-structure-size-boundary.c     | 85 +++++++++++++++++++
 12 files changed, 183 insertions(+), 17 deletions(-)
 create mode 100644 clang/test/CodeGen/arm-structure-size-boundary.c

diff --git a/clang/docs/ReleaseNotes.md b/clang/docs/ReleaseNotes.md
index 4bebce452..b56c4c589 100644
--- a/clang/docs/ReleaseNotes.md
+++ b/clang/docs/ReleaseNotes.md
@@ -84,6 +84,14 @@ in a future version of Clang.
 
 ### ABI Changes in This Version
 
+- Bare-metal AArch32 with `-mabi=apcs-gnu` now follows GCC's record layout:
+  unpacked records have a minimum alignment of 32 bits, and bit-field
+  containers follow their declared type's alignment without raising the
+  record alignment for unnamed fields. AArch32 ELF targets also accept
+  `-mstructure-size-boundary=8|32|64` to change the record alignment floor;
+  as in GCC, 64 is only effective for AAPCS-based ABIs. The default AAPCS
+  layout is unchanged.
+
 - Clang now correctly mangles ``new std::initializer_list<T>{...}``
   expressions under the Itanium C++ ABI. Previous versions emitted a duplicate
   initializer-list marker in the mangled name. (#GH232531)
diff --git a/clang/include/clang/Basic/TargetInfo.h b/clang/include/clang/Basic/TargetInfo.h
index 7c5c35a5c..665af97a8 100644
--- a/clang/include/clang/Basic/TargetInfo.h
+++ b/clang/include/clang/Basic/TargetInfo.h
@@ -941,6 +941,10 @@ public:
     UseSignedCharForObjCBool = false;
   }
 
+  /// Minimum alignment and size-rounding boundary for unpacked records, in
+  /// bits, or zero if the ABI imposes no additional alignment.
+  virtual unsigned getStructureSizeBoundary() const { return 0; }
+
   /// Check whether the alignment of bit-field types is respected
   /// when laying out structures.
   bool useBitFieldTypeAlignment() const {
@@ -979,6 +983,10 @@ public:
     return UseExplicitBitFieldAlignment;
   }
 
+  /// Apply explicit field alignment before testing whether the bit-field fits
+  /// in the container required by its declared type.
+  virtual bool useExplicitBitFieldAlignmentFirst() const { return false; }
+
   /// Check whether this target support '\#pragma options align=mac68k'.
   bool hasAlignMac68kSupport() const {
     return HasAlignMac68kSupport;
diff --git a/clang/include/clang/Basic/TargetOptions.h b/clang/include/clang/Basic/TargetOptions.h
index 8dfc8b879..5ff807cf6 100644
--- a/clang/include/clang/Basic/TargetOptions.h
+++ b/clang/include/clang/Basic/TargetOptions.h
@@ -44,6 +44,9 @@ public:
   /// If given, the name of the target ABI to use.
   std::string ABI;
 
+  /// Explicit AArch32 record size boundary in bits, or zero for the ABI default.
+  unsigned StructureSizeBoundary = 0;
+
   /// The EABI version to use
   llvm::EABI EABIVersion = llvm::EABI::Default;
 
diff --git a/clang/include/clang/Options/Options.td b/clang/include/clang/Options/Options.td
index db5ec793b..842218bad 100644
--- a/clang/include/clang/Options/Options.td
+++ b/clang/include/clang/Options/Options.td
@@ -5633,6 +5633,10 @@ def malign_jumps_EQ : Joined<["-"], "malign-jumps=">, Group<clang_ignored_m_Grou
 let Flags = [TargetSpecific] in {
 def mabi_EQ : Joined<["-"], "mabi=">, Group<m_Group>,
   Visibility<[ClangOption, CC1Option, FlangOption, FC1Option]>;
+def mstructure_size_boundary_EQ : Joined<["-"], "mstructure-size-boundary=">,
