 def malign_branch_EQ : CommaJoined<["-"], "malign-branch=">, Group<m_Group>,
   HelpText<"Specify types of branches to align">;
 def malign_branch_boundary_EQ : Joined<["-"], "malign-branch-boundary=">, Group<m_Group>,
diff --git a/clang/lib/AST/RecordLayoutBuilder.cpp b/clang/lib/AST/RecordLayoutBuilder.cpp
index 40b747da5..bac9f8d6f 100644
--- a/clang/lib/AST/RecordLayoutBuilder.cpp
+++ b/clang/lib/AST/RecordLayoutBuilder.cpp
@@ -1339,6 +1339,17 @@ void ItaniumRecordLayoutBuilder::InitializeLayout(const Decl *D) {
 
     if (unsigned MaxAlign = D->getMaxAlignment())
       UpdateAlignment(Context.toCharUnitsFromBits(MaxAlign));
+
+    // The ABI's structure-size boundary is a minimum record alignment, not a
+    // field-alignment requirement. Packing caps it or, for packed records,
+    // suppresses it altogether.
+    if (isa<RecordDecl>(D)) {
+      CharUnits Boundary = Context.toCharUnitsFromBits(
+          Context.getTargetInfo().getStructureSizeBoundary());
+      if (!MaxFieldAlignment.isZero())
+        Boundary = std::min(Boundary, MaxFieldAlignment);
+      UpdateAlignment(Packed ? CharUnits::One() : Boundary, Boundary);
+    }
   }
 
   HandledFirstNonOverlappingEmptyField =
@@ -1554,7 +1565,7 @@ void ItaniumRecordLayoutBuilder::LayoutBitField(const FieldDecl *D) {
   // where the entire bitfield would fit in an aligned storage unit of
   // the declared type; it's okay if an earlier or later non-bitfield
   // is allocated in the same storage unit.  However, some targets
-  // (those that !useBitFieldTypeAlignment(), e.g. ARM APCS) don't
+  // (those that !useBitFieldTypeAlignment(), e.g. Darwin ARM APCS) don't
   // require this storage unit to be aligned, and therefore always put
   // the bitfield at the next available bit offset.
 
@@ -1724,6 +1735,23 @@ void ItaniumRecordLayoutBuilder::LayoutBitField(const FieldDecl *D) {
       UnfilledBitsInLastUnit = 0;
     }
 
+  } else if (FieldSize && ExplicitFieldAlign &&
+             Context.getTargetInfo().useExplicitBitFieldAlignmentFirst()) {
+    // GCC APCS first advances to the explicit alignment (capped by
+    // #pragma pack), then tests the fit using the natural container.
+    unsigned ExplicitAlign =
+        MaxFieldAlignmentInBits
+            ? std::min(ExplicitFieldAlign, MaxFieldAlignmentInBits)
+            : ExplicitFieldAlign;
+    auto PlaceBitField = [&](uint64_t Offset, bool Packed) {
+      Offset = llvm::alignTo(Offset, ExplicitAlign);
+      if (!Packed && MaxFieldAlignment.isZero() &&
+          (Offset & (FieldInfo.Align - 1)) + FieldSize > StorageUnitSize)
+        Offset = llvm::alignTo(Offset, FieldInfo.Align);
+      return Offset;
+    };
+    FieldOffset = PlaceBitField(FieldOffset, FieldPacked);
+    UnpackedFieldOffset = PlaceBitField(UnpackedFieldOffset, false);
   } else {
     // #pragma pack, with any value, suppresses the insertion of padding.
     bool AllowPadding = MaxFieldAlignment.isZero();
diff --git a/clang/lib/Basic/Targets/ARM.cpp b/clang/lib/Basic/Targets/ARM.cpp
index 807eb8def..82c14c2b9 100644
--- a/clang/lib/Basic/Targets/ARM.cpp
+++ b/clang/lib/Basic/Targets/ARM.cpp
@@ -36,6 +36,7 @@ void ARMTargetInfo::setABIAAPCS() {
     WCharType = UnsignedInt;
 
   UseBitFieldTypeAlignment = true;
+  UseZeroLengthBitfieldAlignment = true;
 
   ZeroLengthBitfieldBoundary = 0;
 
@@ -56,20 +57,32 @@ void ARMTargetInfo::setABIAPCS(bool IsAAPCS16) {
 
   WCharType = SignedInt;
 
-  // Do not respect the alignment of bit-field types when laying out
-  // structures. This corresponds to PCC_BITFIELD_TYPE_MATTERS in gcc.
-  UseBitFieldTypeAlignment = false;
-
-  /// gcc forces the alignment to 4 bytes, regardless of the type of the
-  /// zero length bitfield.  This corresponds to EMPTY_FIELD_BOUNDARY in
-  /// gcc.
-  ZeroLengthBitfieldBoundary = 32;
+  // Bare-metal GCC APCS places bit-fields in naturally aligned containers just
+  // like AAPCS, but unnamed bit-fields (including zero-width fields) do not
+  // contribute to the record's alignment. Keep the historical layout on other
+  // targets that use Clang's APCS calling convention, such as Darwin.
+  UseBitFieldTypeAlignment = usesGNUAPCSRecordLayout();
+  UseZeroLengthBitfieldAlignment = !UseBitFieldTypeAlignment;
+  ZeroLengthBitfieldBoundary = UseBitFieldTypeAlignment ? 0 : 32;
 
   resetDataLayout();
 
   // FIXME: Override "preferred align" for double and long long.
 }
 
+bool ARMTargetInfo::usesGNUAPCSRecordLayout() const {
+  return ABI == "apcs-gnu" && getTriple().isOSUnknown() &&
+         getTriple().isOSBinFormatELF();
+}
+
+unsigned ARMTargetInfo::getStructureSizeBoundary() const {
+  unsigned Boundary = getTargetOpts().StructureSizeBoundary;
+  // GCC accepts 64 only for AAPCS-based ABIs. APCS falls back to its default.
+  if (Boundary && (Boundary != 64 || IsAAPCS))
+    return Boundary;
+  return usesGNUAPCSRecordLayout() ? 32 : 0;
+}
+
 void ARMTargetInfo::setArchInfo() {
   StringRef ArchName = getTriple().getArchName();
 
@@ -319,12 +332,6 @@ ARMTargetInfo::ARMTargetInfo(const llvm::Triple &Triple,
   if (IsAAPCS && !Triple.isAndroid())
     DefaultAlignForAttributeAligned = MaxVectorAlign = 64;
 
-  // Do force alignment of members that follow zero length bitfields.  If
-  // the alignment of the zero-length bitfield is greater than the member
-  // that follows it, `bar', `bar' will be aligned as the  type of the
-  // zero length bitfield.
-  UseZeroLengthBitfieldAlignment = true;
-
   if (Triple.getOS() == llvm::Triple::Linux ||
       Triple.getOS() == llvm::Triple::UnknownOS)
     this->MCountName =
